{
  "name": "Textus",
  "slug": "textus",
  "identifier": "com.catvinci.textus",
  "version": "1.4.7",
  "copyright": "© 2026 CatVinci Studio",
  "license": "MIT",
  "publisher": "CatVinci Studio",
  "icon": "packaging/icons/icon.png",
  "devUrl": "http://localhost:1420",
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "frontendDist": "dist",
  "bindings": "src/platform/native/host-client.ts",
  "out": "dist-app",
  "urlSchemes": ["textus"],
  "fileAssociations": [
    {
      "ext": ["md", "markdown"],
      "name": "Markdown document",
      "mimeType": "text/markdown",
      "role": "Editor"
    },
    {
      "ext": ["mdx"],
      "name": "MDX document",
      "mimeType": "text/mdx",
      "role": "Editor"
    }
  ],
  "updates": {
    "publicKey": "pB1kfBMM9YupB4EMDAzP/6EYWT9N06GOW33q/Ah3Eyo=",
    "github": "atoz03/Textus"
  },
  "macos": {
    "icon": "packaging/icons/icon.icns",
    "minimumSystemVersion": "13.0"
  },
  "windows": {
    "installerInclude": "packaging/windows/installer.nsh"
  },
  "linux": {
    "maintainer": "CatVinci Studio",
    "comment": "Integrated Writing Environment, designed for professional writing",
    "categories": ["Utility", "TextEditor"],
    "depends": ["libayatana-appindicator3-1"],
    "command": "textus"
  }
}
